{
  "name": "ai-nazar-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate --schema=prisma/sqlite/schema.prisma && prisma generate --schema=prisma/postgres/schema.prisma",
    "db:migrate:sqlite": "prisma migrate deploy --config=prisma/sqlite/prisma.config.ts",
    "db:migrate:postgres": "prisma migrate deploy --config=prisma/postgres/prisma.config.ts",
    "db:migrate:dev:sqlite": "prisma migrate dev --config=prisma/sqlite/prisma.config.ts",
    "db:migrate:dev:postgres": "prisma migrate dev --config=prisma/postgres/prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^13.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "postbasejs": "^0.5.16",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
